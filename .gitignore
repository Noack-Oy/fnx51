__pycache__

# KiCad 10's Local History (Preferences > Common > Project Backup). KiCad keeps
# automatic snapshots of the project here and manages them AS A GIT REPOSITORY
# -- so `git add` on the project records .history as a gitlink rather than
# recursing into it, and the result is a submodule entry with no URL pointing
# at a commit that exists nowhere. That is what pcb/.history was.
#
# Ignoring it is the fix; do not delete it on a working machine unless you mean
# to, because the snapshots are the only copy. File > Local History browses them.
.history/

# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*.kicad_prl
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# VIM
*.swp
